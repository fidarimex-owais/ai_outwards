# Same keys as .env.example, but for use with docker-compose.yml's env_file: directive.
#
# IMPORTANT: Docker Compose interpolates `$` in env_file values as variable references
# (e.g. `$tYHpOc2rkZ36` is read as `${tYHpOc2rkZ36}`, an unset variable, and silently
# becomes blank). A bcrypt hash always contains literal `$` characters (e.g.
# "$2b$12$..."), so every `$` in OPERATOR_CREDENTIALS below MUST be doubled to `$$` or
# the hash gets corrupted when it reaches the container - login will fail with no error
# explaining why. This escaping requirement is specific to Docker Compose; the plain
# `.env` file used for local (non-Docker) runs does NOT need it, which is why this is a
# separate file rather than reusing .env directly.
#
# MONGO_URL and REDIS_URL are NOT set here - docker-compose.yml overrides them directly
# to point at the `mongo` and `redis` service names on the compose network.

MONGO_DB_NAME=voice_assistant
SESSION_TTL_SECONDS=3600

GEMINI_API_KEY=
BACKUP_LLM_PROVIDER=groq
BACKUP_LLM_API_KEY=

STT_PROVIDER=whisper
STT_API_KEY=

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Example: a hash containing "$2b$12$tYHpOc2rkZ36..." must be written as "$$2b$$12$$tYHpOc2rkZ36..."
OPERATOR_CREDENTIALS=

ENVIRONMENT=production
LOG_LEVEL=INFO
