# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=voice_assistant

# Redis
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# LLM providers
GEMINI_API_KEY=
BACKUP_LLM_PROVIDER=groq
BACKUP_LLM_API_KEY=
# Which provider to try first - "gemini" or "groq". The other one is always the automatic
# fallback. Defaults to "gemini" if missing or set to anything else.
LLM_PRIMARY_PROVIDER=gemini
# Gemini model id. Default gemini-3.8-flash is limited to 20 requests/day on the free tier. Lite models allow 500/day.
GEMINI_MODEL=gemini-3.8-flash

# Speech-to-Text
STT_PROVIDER=groq
STT_API_KEY=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Static operator list: "username:bcrypt_hash;username2:bcrypt_hash2"
# Generate a hash with: python -c "from app.core.security import hash_password; print(hash_password('your-password'))"
OPERATOR_CREDENTIALS=

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call this API (the separate React+Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
